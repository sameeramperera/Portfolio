---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PostList from '@/components/PostList.astro';
import { getPosts } from '@/lib/posts';
import { links } from '@/config';

const posts = await getPosts();
---

<Base title="Writing" description="Articles I've published on Medium.">
  <PageHeader title="writing" lead="Articles I've published on Medium." />
  <PostList posts={posts} headingLevel="h2" />
  {links.medium && (
    <p class="mt-8">
      <a
        href={links.medium}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 border border-line px-4 py-2 font-mono text-sm no-underline transition-colors hover:border-accent hover:text-accent"
      >
        read more on medium <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span>
      </a>
    </p>
  )}
</Base>
